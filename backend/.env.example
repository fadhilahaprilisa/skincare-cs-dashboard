# ==============================================
# LUMIÈRE SKIN - Backend Environment Variables
# ==============================================

# 1. LANGFLOW CONFIGURATION
# -------------------------
# URL endpoint dari Langflow workflow-mu.
# Jika Langflow berjalan di local, biasanya:
# http://127.0.0.1:7861/api/v1/run/[FLOW_ID]
LANGFLOW_API_URL="http://127.0.0.1:7861/api/v1/run/YOUR_FLOW_ID_HERE"

# API Key yang dibuat di halaman Settings Langflow.
LANGFLOW_API_KEY="sk-YOUR_LANGFLOW_API_KEY_HERE"

# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# -------------------------------------------------
# Connection string untuk PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REFERENCE.supabase.co:5432/postgres"